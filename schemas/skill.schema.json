{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/krizaka/krizaka-skills/schemas/skill.schema.json",
  "title": "SKILL.md front matter (Agent Skills specification, agentskills.io/specification)",
  "type": "object",
  "required": ["name", "description"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Lowercase letters, digits and single hyphens; matches the skill's directory."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "What the skill does and when to use it."
    },
    "license": { "type": "string", "minLength": 1 },
    "compatibility": { "type": "string", "minLength": 1, "maxLength": 500 },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "allowed-tools": { "type": "string", "minLength": 1 }
  }
}
